# Build-time compilation of native/hud.hlsl for native/renderer.cpp.
#
#   cmake -DFXC=<fxc.exe> -DSOURCE=<hud.hlsl> -DOUTPUT=<hud_shaders.hpp> -P renderer.shaders.cmake
#
# Every entry point the renderer creates is compiled with the flags of its
# former runtime D3DCompileFromFile call (D3DCOMPILE_ENABLE_STRICTNESS = /Ges,
# D3DCOMPILE_OPTIMIZATION_LEVEL3 = /O3) by the Windows SDK's fxc (the same
# d3dcompiler_47). The generated header carries the bytecode and the SHA-256
# of the exact source bytes: the renderer uses it only for an identical
# hud.hlsl (the staged shell/hud.hlsl, or a test's source path) and compiles
# any other source at run time as before.
cmake_minimum_required(VERSION 3.25)
foreach(required FXC SOURCE OUTPUT)
  if(NOT ${required})
    message(FATAL_ERROR "${required} is required")
  endif()
endforeach()
get_filename_component(work "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${work}")
file(SHA256 "${SOURCE}" source_sha256)
set(entries
  "SceneVS|vs_5_0" "ScenePS|ps_5_0" "SceneEncodedInputPS|ps_5_0" "SceneEncodedOutputPS|ps_5_0"
  "SceneEncodedBothPS|ps_5_0" "CompositeVS|vs_5_0" "CompositePS|ps_5_0" "MediaConvertPS|ps_5_0")
set(arrays "")
set(table "")
set(row "")
foreach(n RANGE 1 16)
  string(APPEND row "0x[0-9a-f][0-9a-f],")
endforeach()
foreach(entry IN LISTS entries)
  string(REPLACE "|" ";" parts "${entry}")
  list(GET parts 0 name)
  list(GET parts 1 profile)
  set(object "${work}/hud_${name}.cso")
  file(REMOVE "${object}")
  execute_process(COMMAND "${FXC}" /nologo /Ges /O3 /T "${profile}" /E "${name}" /Fo "${object}" "${SOURCE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT result EQUAL 0 OR NOT EXISTS "${object}")
    message(FATAL_ERROR "fxc could not compile ${name} (${profile}) from ${SOURCE}:\n${output}\n${errors}")
  endif()
  file(READ "${object}" bytes HEX)
  string(LENGTH "${bytes}" digits)
  if(digits EQUAL 0)
    message(FATAL_ERROR "fxc produced no bytecode for ${name}")
  endif()
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
  # 16 bytes per line (CMake regular expressions have no {n} repetition).
  string(REGEX REPLACE "(${row})" "\\1\n" bytes "${bytes}")
  string(APPEND arrays "inline constexpr unsigned char ${name}[]{${bytes}};\n")
  string(APPEND table "    {\"${name}\", \"${profile}\", ${name}, sizeof(${name})},\n")
  file(REMOVE "${object}")
endforeach()
set(text "#pragma once
// Generated by native/renderer.shaders.cmake from native/hud.hlsl. Do not edit.
#include <cstddef>
#include <string_view>

namespace endfield::native::hud_shaders {
// SHA-256 of the exact hud.hlsl bytes this bytecode was compiled from.
inline constexpr std::string_view sourceSHA256{\"${source_sha256}\"};
${arrays}struct Entry { std::string_view name, profile; const unsigned char* bytes; std::size_t size; };
inline constexpr Entry entries[]{
${table}};
} // namespace endfield::native::hud_shaders
")
file(WRITE "${OUTPUT}" "${text}")
