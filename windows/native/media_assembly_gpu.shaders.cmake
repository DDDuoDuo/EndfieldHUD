# Build-time compilation of native/media_assembly_gpu.hlsl for
# native/media_assembly_gpu.cpp (the Media Assembly GPU processor).
#
#   cmake [-DFXC=<fxc.exe>] -DSOURCE=<media_assembly_gpu.hlsl> -DOUTPUT=<media_assembly_gpu_shaders.hpp> -P media_assembly_gpu.shaders.cmake
#
# The generated header always carries the exact HLSL text: without fxc the
# processor compiles it at run time with D3DCompile, as before. With the
# Windows SDK's fxc (the same d3dcompiler_47) it also carries the bytecode of
# every entry point, compiled with the run-time flags
# (D3DCOMPILE_IEEE_STRICTNESS = /Gis, D3DCOMPILE_OPTIMIZATION_LEVEL3 = /O3),
# so the HUD never compiles HLSL for Media Assembly and its GPU previews are
# available from the editor's first frame.
cmake_minimum_required(VERSION 3.25)
foreach(required SOURCE OUTPUT)
  if(NOT ${required})
    message(FATAL_ERROR "${required} is required")
  endif()
endforeach()
get_filename_component(work "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${work}")
file(READ "${SOURCE}" text)
file(SHA256 "${SOURCE}" source_sha256)
string(FIND "${text}" ")hlsl\"" clash)
if(NOT clash EQUAL -1)
  message(FATAL_ERROR "${SOURCE} contains the raw string delimiter )hlsl\"")
endif()
set(entries "FullScreen|vs_4_0" "Process|ps_4_0" "Resample|ps_4_0")
set(arrays "")
set(table "")
set(embedded false)
if(FXC)
  set(embedded true)
  set(row "")
  foreach(n RANGE 1 16)
    string(APPEND row "0x[0-9a-f][0-9a-f],")
  endforeach()
  foreach(entry IN LISTS entries)
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 name)
    list(GET parts 1 profile)
    set(object "${work}/media_assembly_${name}.cso")
    file(REMOVE "${object}")
    execute_process(COMMAND "${FXC}" /nologo /Gis /O3 /T "${profile}" /E "${name}" /Fo "${object}" "${SOURCE}"
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result EQUAL 0 OR NOT EXISTS "${object}")
      message(FATAL_ERROR "fxc could not compile ${name} (${profile}) from ${SOURCE}:\n${output}\n${errors}")
    endif()
    file(READ "${object}" bytes HEX)
    string(LENGTH "${bytes}" digits)
    if(digits EQUAL 0)
      message(FATAL_ERROR "fxc produced no bytecode for ${name}")
    endif()
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
    # 16 bytes per line (CMake regular expressions have no {n} repetition).
    string(REGEX REPLACE "(${row})" "\\1\n" bytes "${bytes}")
    string(APPEND arrays "inline constexpr unsigned char ${name}[]{${bytes}};\n")
    string(APPEND table "    {\"${name}\", \"${profile}\", ${name}, sizeof(${name})},\n")
    file(REMOVE "${object}")
  endforeach()
else()
  foreach(entry IN LISTS entries)
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 name)
    list(GET parts 1 profile)
    string(APPEND table "    {\"${name}\", \"${profile}\", nullptr, 0},\n")
  endforeach()
endif()
set(header "#pragma once
// Generated by native/media_assembly_gpu.shaders.cmake from
// native/media_assembly_gpu.hlsl. Do not edit.
#include <cstddef>
#include <string_view>

namespace endfield::native::media_assembly_shaders {
// SHA-256 of the exact media_assembly_gpu.hlsl bytes below.
inline constexpr std::string_view sourceSHA256{\"${source_sha256}\"};
// The HLSL text (the run-time D3DCompile input when no bytecode is embedded).
inline constexpr char source[]=R\"hlsl(${text})hlsl\";
// True when every entry point below carries fxc bytecode of that text.
inline constexpr bool embedded=${embedded};
${arrays}struct Entry { std::string_view name, profile; const unsigned char* bytes; std::size_t size; };
inline constexpr Entry entries[]{
${table}};
} // namespace endfield::native::media_assembly_shaders
")
file(WRITE "${OUTPUT}" "${header}")
