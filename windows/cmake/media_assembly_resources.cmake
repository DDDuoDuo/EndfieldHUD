# Media Assembly PhotoMode derivatives: verifies a resource folder (the shared
# Mac Resources/MediaAssembly, staged verbatim as resources/media-assembly)
# against its provenance.json. The folder must hold exactly provenance.json and
# every file it lists, each with the listed byte count and SHA-256, and nothing
# else (ignoring the .DS_Store/Thumbs.db that app/stage_resources.cmake also
# skips), so the package never carries an unlisted file such as a removed
# promotional sticker or a stray copy. The runtime catalog
# (native/media_assembly_assets.cpp) pins provenance.json itself and resolves
# the listed files by the source raw ids; this script does not repeat that pin.
#
#   include(): call ehud_media_assembly_check(<dir> <result-variable>); a
#     mismatch is FATAL_ERROR, the result is the sorted relative file list.
#   cmake -DSOURCE=<dir> [-DSTAGE_SCRIPT=<app/stage_resources.cmake> -DOUT=<scratch dir>]
#         -P media_assembly_resources.cmake
#     checks <dir>; with STAGE_SCRIPT it also stages <dir> alone as
#     mediaAssembly.assets and requires its resources.json entry to list the
#     same files with the same pins (the packaging staging contract).
if(CMAKE_SCRIPT_MODE_FILE)
  cmake_minimum_required(VERSION 3.25)
endif()
function(ehud_media_assembly_check dir result)
  set(provenance "${dir}/provenance.json")
  if(NOT EXISTS "${provenance}")
    message(FATAL_ERROR "Media Assembly resources: ${provenance} is missing")
  endif()
  file(READ "${provenance}" json)
  string(JSON version GET "${json}" formatVersion)
  string(JSON count LENGTH "${json}" files)
  if(NOT version EQUAL 1 OR count LESS 1)
    message(FATAL_ERROR "Media Assembly resources: ${provenance} is not a format 1 file list")
  endif()
  set(listed "provenance.json")
  math(EXPR last "${count}-1")
  foreach(index RANGE ${last})
    string(JSON relative GET "${json}" files ${index} file)
    string(JSON bytes GET "${json}" files ${index} bytes)
    string(JSON sha GET "${json}" files ${index} sha256)
    if(NOT relative MATCHES "^(luts/[a-z0-9_]+\\.rgb8|filter-icons/[a-z0-9_]+\\.png|stickers/[a-z0-9_]+\\.png)$" OR relative IN_LIST listed)
      message(FATAL_ERROR "Media Assembly resources: unexpected or duplicate provenance entry ${relative}")
    endif()
    if(NOT EXISTS "${dir}/${relative}")
      message(FATAL_ERROR "Media Assembly resources: ${relative} is listed but missing")
    endif()
    file(SIZE "${dir}/${relative}" actual_bytes)
    file(SHA256 "${dir}/${relative}" actual_sha)
    if(NOT actual_bytes EQUAL bytes OR NOT actual_sha STREQUAL sha)
      message(FATAL_ERROR "Media Assembly resources: ${relative} differs from provenance.json")
    endif()
    list(APPEND listed "${relative}")
  endforeach()
  file(GLOB_RECURSE present LIST_DIRECTORIES false RELATIVE "${dir}" "${dir}/*")
  set(unlisted "")
  foreach(relative IN LISTS present)
    get_filename_component(name "${relative}" NAME)
    if(NOT relative IN_LIST listed AND NOT name STREQUAL ".DS_Store" AND NOT name STREQUAL "Thumbs.db")
      list(APPEND unlisted "${relative}")
    endif()
  endforeach()
  if(unlisted)
    message(FATAL_ERROR "Media Assembly resources: files not in provenance.json would ship: ${unlisted}")
  endif()
  list(SORT listed)
  set(${result} "${listed}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE AND CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  if(NOT SOURCE)
    message(FATAL_ERROR "SOURCE is required")
  endif()
  ehud_media_assembly_check("${SOURCE}" expected)
  list(LENGTH expected expected_count)
  if(STAGE_SCRIPT)
    if(NOT OUT)
      message(FATAL_ERROR "OUT is required with STAGE_SCRIPT")
    endif()
    file(REMOVE_RECURSE "${OUT}")
    file(MAKE_DIRECTORY "${OUT}")
    file(WRITE "${OUT}/specs.txt" "mediaAssembly.assets|directory|${SOURCE}|media-assembly\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSTAGE_DIR=${OUT}/resources" -DSOURCE_COMMIT=media-assembly-check
      "-DRESOURCE_SPECS_FILE=${OUT}/specs.txt" -P "${STAGE_SCRIPT}" RESULT_VARIABLE staged OUTPUT_QUIET ERROR_VARIABLE errors)
    if(NOT staged EQUAL 0)
      message(FATAL_ERROR "Staging the Media Assembly resources failed: ${errors}")
    endif()
    file(READ "${OUT}/resources/resources.json" manifest)
    string(JSON path GET "${manifest}" resources mediaAssembly.assets path)
    string(JSON kind GET "${manifest}" resources mediaAssembly.assets kind)
    string(JSON staged_count LENGTH "${manifest}" resources mediaAssembly.assets files)
    if(NOT path STREQUAL "media-assembly" OR NOT kind STREQUAL "directory" OR NOT staged_count EQUAL expected_count)
      message(FATAL_ERROR "Staged mediaAssembly.assets lists ${staged_count} files at ${path}; provenance.json implies ${expected_count}")
    endif()
    set(pinned "")
    math(EXPR last "${staged_count}-1")
    foreach(index RANGE ${last})
      string(JSON relative GET "${manifest}" resources mediaAssembly.assets files ${index} path)
      string(JSON bytes GET "${manifest}" resources mediaAssembly.assets files ${index} bytes)
      string(JSON sha GET "${manifest}" resources mediaAssembly.assets files ${index} sha256)
      file(SIZE "${SOURCE}/${relative}" source_bytes)
      file(SHA256 "${SOURCE}/${relative}" source_sha)
      if(NOT relative IN_LIST expected OR NOT bytes EQUAL source_bytes OR NOT sha STREQUAL source_sha)
        message(FATAL_ERROR "Staged media-assembly/${relative} is not the verified source file")
      endif()
      list(APPEND pinned "${relative}")
    endforeach()
    file(GLOB_RECURSE copied LIST_DIRECTORIES false RELATIVE "${OUT}/resources" "${OUT}/resources/*")
    list(LENGTH copied copied_count)
    math(EXPR copied_expected "${expected_count}+1")
    if(NOT copied_count EQUAL copied_expected)
      message(FATAL_ERROR "The staged tree holds ${copied_count} files; expected resources.json plus ${expected_count}")
    endif()
    # A folder with an unlisted sticker (a removed promotional one) or a
    # changed listed file is refused.
    foreach(damage IN ITEMS unlisted changed)
      file(REMOVE_RECURSE "${OUT}/${damage}")
      file(COPY "${SOURCE}/" DESTINATION "${OUT}/${damage}")
      if(damage STREQUAL "unlisted")
        file(COPY_FILE "${SOURCE}/stickers/sticker_giftpack_1.png" "${OUT}/${damage}/stickers/sticker_giftpack_2.png")
      else()
        file(APPEND "${OUT}/${damage}/stickers/sticker_giftpack_1.png" "x")
      endif()
      execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE=${OUT}/${damage}" -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE refused OUTPUT_QUIET ERROR_QUIET)
      if(refused EQUAL 0)
        message(FATAL_ERROR "A Media Assembly folder with a ${damage} file was accepted")
      endif()
    endforeach()
    file(REMOVE_RECURSE "${OUT}")
  endif()
  message(STATUS "Media Assembly resources verified: ${expected_count} files (provenance.json and its listed assets)")
endif()
