# Personal Profile, bottom-left ID card binding and Work Mode lifetime hours.
# Included at the end of windows/CMakeLists.txt, after every existing target.
# Portable targets build on Windows (system ICU) or wherever a local ICU exists.
if(NOT WIN32 AND NOT ICU_FOUND)
  find_package(ICU QUIET COMPONENTS uc i18n)
endif()
if(WIN32 OR ICU_FOUND)
  add_library(hud_profile modules/profile_state.cpp native/profile_text.cpp modules/profile_service.cpp modules/work_mode_profile_hours.cpp modules/id_card_binding.cpp modules/profile_events.cpp modules/profile_artwork.cpp modules/id_card_artwork.cpp)
  target_include_directories(hud_profile PUBLIC ${CMAKE_CURRENT_SOURCE_DIR})
  target_link_libraries(hud_profile PUBLIC hud_data hud_scene hud_localization hud_utility hud_work_mode hud_source_motion hud_packet)
  if(WIN32)
    target_compile_definitions(hud_profile PRIVATE _WIN32_WINNT=0x0A00 UNICODE _UNICODE NOMINMAX)
    target_link_libraries(hud_profile PRIVATE icu)
  else()
    target_link_libraries(hud_profile PRIVATE ICU::uc ICU::i18n)
  endif()
  if(MSVC)
    target_compile_options(hud_profile PRIVATE /W4 /permissive- /EHsc)
  else()
    target_compile_options(hud_profile PRIVATE -Wall -Wextra -Wpedantic)
  endif()
  # Personal ID on the design library (Mac 1.3.0 PersonalProfileCanvas).
  add_library(hud_profile_canvas modules/profile_canvas.cpp)
  target_include_directories(hud_profile_canvas PUBLIC ${CMAKE_CURRENT_SOURCE_DIR})
  target_link_libraries(hud_profile_canvas PUBLIC hud_profile hud_design)
  if(MSVC)
    target_compile_options(hud_profile_canvas PRIVATE /W4 /permissive- /EHsc)
  else()
    target_compile_options(hud_profile_canvas PRIVATE -Wall -Wextra -Wpedantic)
  endif()
  if(BUILD_TESTING)
    add_executable(profile_state_tests tests/profile_state_tests.cpp)
    target_link_libraries(profile_state_tests PRIVATE hud_profile)
    add_test(NAME profile_state_contracts COMMAND profile_state_tests ${CMAKE_CURRENT_SOURCE_DIR}/tests/fixtures/profile-state-source.json)
    add_executable(profile_service_tests tests/profile_service_tests.cpp)
    target_link_libraries(profile_service_tests PRIVATE hud_profile)
    add_test(NAME profile_service_contracts COMMAND profile_service_tests)
    add_executable(profile_canvas_tests tests/profile_canvas_tests.cpp)
    target_link_libraries(profile_canvas_tests PRIVATE hud_profile_canvas)
    add_test(NAME profile_canvas_contracts COMMAND profile_canvas_tests ${CMAKE_CURRENT_SOURCE_DIR}/tests/fixtures/profile-canvas-source.json)
    add_executable(id_card_artwork_tests tests/id_card_artwork_tests.cpp)
    target_link_libraries(id_card_artwork_tests PRIVATE hud_profile)
    add_test(NAME id_card_artwork_contracts COMMAND id_card_artwork_tests ${CMAKE_CURRENT_SOURCE_DIR}/tests/fixtures/id_card-artwork-source.json ${CMAKE_CURRENT_SOURCE_DIR}/resources/profile)
    add_executable(id_card_binding_tests tests/id_card_binding_tests.cpp)
    target_link_libraries(id_card_binding_tests PRIVATE hud_profile)
    add_test(NAME id_card_binding_contracts COMMAND id_card_binding_tests ${CMAKE_CURRENT_SOURCE_DIR}/tests/fixtures/id_card-source.json)
  endif()
endif()

# Native Win32 services: managed images, pickers, the ID card presenter and the
# owner of the Personal ID design page (tools/profile_owner: the canvas in a
# DesignOwnerCore, the portrait's panning images, the owner-drawn art).
if(WIN32 AND TARGET hud_profile AND TARGET hud_design_native)
  add_library(hud_profile_native native/profile_image.cpp native/id_card_captions.cpp native/id_card_presenter.cpp native/profile_pickers.cpp tools/profile_owner.cpp)
  target_include_directories(hud_profile_native PUBLIC ${CMAKE_CURRENT_SOURCE_DIR})
  target_compile_definitions(hud_profile_native PRIVATE _WIN32_WINNT=0x0A00 WINVER=0x0A00 UNICODE _UNICODE NOMINMAX)
  target_link_libraries(hud_profile_native PUBLIC hud_profile hud_profile_canvas hud_design_native hud_native hud_overlay_host PRIVATE windowscodecs ole32 oleaut32 comdlg32 uiautomationcore)
  if(MSVC)
    target_compile_options(hud_profile_native PRIVATE /W4 /permissive- /EHsc)
  endif()
  # Opt-in cold-start trace of the profile area's owner-thread work (timings
  # only, hidden WARP window, temporary data root); a diagnostic, not a test.
  add_executable(profile_cold_start_probe tools/profile_cold_start_probe.cpp)
  target_compile_definitions(profile_cold_start_probe PRIVATE UNICODE _UNICODE NOMINMAX)
  target_link_libraries(profile_cold_start_probe PRIVATE hud_profile_native hud_work_mode_canvas windowscodecs ole32 psapi)
  if(MSVC)
    target_compile_options(profile_cold_start_probe PRIVATE /W4 /permissive- /EHsc)
  endif()
  if(BUILD_TESTING)
    add_executable(profile_image_tests tests/profile_image_tests.cpp)
    target_compile_definitions(profile_image_tests PRIVATE UNICODE _UNICODE NOMINMAX)
    target_link_libraries(profile_image_tests PRIVATE hud_profile_native windowscodecs ole32)
    add_test(NAME profile_image_contracts COMMAND profile_image_tests)
    add_executable(profile_owner_tests tests/profile_owner_tests.cpp)
    target_compile_definitions(profile_owner_tests PRIVATE UNICODE _UNICODE NOMINMAX)
    target_link_libraries(profile_owner_tests PRIVATE hud_profile_native windowscodecs ole32)
    if(MSVC)
      target_compile_options(profile_owner_tests PRIVATE /W4 /permissive- /EHsc)
    endif()
    add_test(NAME profile_owner_contracts COMMAND profile_owner_tests ${CMAKE_CURRENT_SOURCE_DIR}/native/hud.hlsl ${CMAKE_CURRENT_SOURCE_DIR}/resources/profile)
    add_executable(profile_pickers_tests tests/profile_pickers_tests.cpp)
    target_compile_definitions(profile_pickers_tests PRIVATE UNICODE _UNICODE NOMINMAX)
    target_link_libraries(profile_pickers_tests PRIVATE hud_profile_native ole32)
    add_test(NAME profile_pickers_contracts COMMAND profile_pickers_tests)
    add_executable(id_card_captions_tests tests/id_card_captions_tests.cpp)
    target_compile_definitions(id_card_captions_tests PRIVATE UNICODE _UNICODE NOMINMAX)
    target_link_libraries(id_card_captions_tests PRIVATE hud_profile_native ole32)
    add_test(NAME id_card_captions_contracts COMMAND id_card_captions_tests ${CMAKE_CURRENT_SOURCE_DIR}/tests/fixtures/id_card-native-captions.json ${CMAKE_CURRENT_SOURCE_DIR}/resources/profile)
    add_executable(id_card_presenter_tests tests/id_card_presenter_tests.cpp)
    target_compile_definitions(id_card_presenter_tests PRIVATE UNICODE _UNICODE NOMINMAX)
    target_link_libraries(id_card_presenter_tests PRIVATE hud_profile_native ole32)
    add_test(NAME id_card_presenter_contracts COMMAND id_card_presenter_tests ${CMAKE_CURRENT_SOURCE_DIR}/tests/fixtures/id_card-native-captions.json ${CMAKE_CURRENT_SOURCE_DIR}/resources/profile)
    if(MSVC)
      target_compile_options(id_card_presenter_tests PRIVATE /W4 /permissive- /EHsc)
    endif()
    # The host's shell SourceScene (it carries the ID card textures) over the
    # packaged catalog: no CPU texture copy after upload, identical frames.
    if(ehud_app_inputs AND EXISTS "${ehud_app_inputs}/profile-outline-catalog.ehscene")
      add_executable(profile_shell_scene_tests tests/profile_shell_scene_tests.cpp)
      target_compile_definitions(profile_shell_scene_tests PRIVATE UNICODE _UNICODE NOMINMAX)
      target_link_libraries(profile_shell_scene_tests PRIVATE hud_native ole32)
      if(MSVC)
        target_compile_options(profile_shell_scene_tests PRIVATE /W4 /permissive- /EHsc)
      endif()
      add_test(NAME profile_shell_scene_contracts COMMAND profile_shell_scene_tests ${CMAKE_CURRENT_SOURCE_DIR}/native/hud.hlsl "${ehud_app_inputs}/profile-outline-catalog.ehscene")
    endif()
  endif()
endif()

# Module area (app/module_owner.hpp, "Adding a module area"): the Personal
# Profile owner joins EndfieldHUD.exe and the hidden coverage through the
# registered factory; the card artwork and pinned card source are packaged as
# resources/profile. The host's bottom-left card presenter
# (native/id_card_presenter.hpp) lives in hud_profile_native, linked into the
# application owner so the host can bind the published ID card feed.
if(WIN32 AND TARGET hud_profile_native AND TARGET hud_module_registry AND TARGET hud_hypergryph_account)
  add_library(hud_profile_area STATIC app/areas/profile_module.cpp)
  target_include_directories(hud_profile_area PUBLIC ${CMAKE_CURRENT_SOURCE_DIR})
  target_compile_definitions(hud_profile_area PRIVATE _WIN32_WINNT=0x0A00 WINVER=0x0A00 UNICODE _UNICODE NOMINMAX)
  target_link_libraries(hud_profile_area PUBLIC hud_module_registry hud_profile_native hud_utility PRIVATE hud_hypergryph_account hud_design_native windowscodecs ole32 oleaut32 user32 uiautomationcore)
  if(MSVC)
    target_compile_options(hud_profile_area PRIVATE /W4 /permissive- /EHsc)
  endif()
  set_property(GLOBAL APPEND PROPERTY EHUD_APP_AREAS
    "profile|hud_profile_area|app/areas/profile_module.hpp|endfield::areas::profileModule")
  set_property(GLOBAL APPEND PROPERTY EHUD_APP_AREA_FIXTURES
    "profile.idCardCaptions|${CMAKE_CURRENT_SOURCE_DIR}/tests/fixtures/id_card-native-captions.json")
  if(COMMAND ehud_app_resource)
    ehud_app_resource(profile directory "${CMAKE_CURRENT_SOURCE_DIR}/resources/profile" "profile")
  endif()
  if(TARGET hud_application)
    target_link_libraries(hud_application PRIVATE hud_profile_native)
  endif()
endif()
