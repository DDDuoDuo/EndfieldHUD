# CTest driver for now_playing_probe's acceptance report (Windows):
#   cmake -DPROBE=<now_playing_probe.exe> -DSCENARIO=<replay.json> [-DWINDOWS_SCENARIO=<windows replay.json>]
#         -DWORK=<private dir> -P now_playing_probe_check.cmake
# Two synthetic replays (--replay: scripted provider, transport answers and
# audio rows; no media session, network or audio device) merge into one
# report and its Markdown, --show prints it, and a file that is not such a
# report is refused and left unchanged. WORK is created and removed here.
foreach(required PROBE SCENARIO WORK)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "now_playing_probe_check needs -D${required}=...")
  endif()
endforeach()

function(probe_fail what)
  file(REMOVE_RECURSE "${WORK}")
  message(FATAL_ERROR "now_playing_probe_matrix: ${what}")
endfunction()
function(probe_run result output)
  execute_process(COMMAND "${PROBE}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  set(${result} "${code}" PARENT_SCOPE)
  set(${output} "${out}${err}" PARENT_SCOPE)
endfunction()
# Row index of a player in the report JSON (or -1).
function(probe_row json player index)
  string(JSON count LENGTH "${json}" rows)
  math(EXPR last "${count} - 1")
  set(found -1)
  foreach(k RANGE ${last})
    string(JSON key GET "${json}" rows ${k} player)
    if(key STREQUAL player)
      set(found ${k})
    endif()
  endforeach()
  set(${index} ${found} PARENT_SCOPE)
endfunction()

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(report "${WORK}/matrix.json")
set(markdown "${WORK}/matrix.md")

# Run 1: no options (lyrics, volume and command stay unverified).
probe_run(code out --replay "${SCENARIO}" --report "${report}" --markdown "${markdown}")
if(NOT code EQUAL 0)
  probe_fail("first replay exited ${code}: ${out}")
endif()
if(NOT out MATCHES "\"event\":\"matrix\"" OR NOT out MATCHES "\"event\":\"activated\"")
  probe_fail("first replay printed no activation or matrix line")
endif()
file(READ "${report}" json)
probe_row("${json}" spotifyDesktop spotify)
if(spotify LESS 0)
  probe_fail("the report has no Spotify row")
endif()
string(JSON verdict GET "${json}" rows ${spotify} verdict)
string(JSON lyrics GET "${json}" rows ${spotify} checks lyrics verdict)
if(NOT verdict STREQUAL "partial" OR NOT lyrics STREQUAL "unverified")
  probe_fail("run 1 Spotify is ${verdict} with lyrics ${lyrics}, expected partial/unverified")
endif()

# Run 2: every option; the merged report holds both runs.
probe_run(code out --replay "${SCENARIO}" --lyrics --volume --command next --report "${report}" --markdown "${markdown}")
if(NOT code EQUAL 0)
  probe_fail("second replay exited ${code}: ${out}")
endif()
if(NOT out MATCHES "\"event\":\"playbackAction\"")
  probe_fail("the command produced no playbackAction event")
endif()
file(READ "${report}" json)
string(JSON runs LENGTH "${json}" runs)
string(JSON format GET "${json}" format)
if(NOT runs EQUAL 2 OR NOT format STREQUAL "endfieldhud.nowPlaying.acceptance")
  probe_fail("expected a merged report with 2 runs, got ${runs} (${format})")
endif()
foreach(player_verdict spotifyDesktop=pass qqMusic=fail kugou=fail neteaseDesktop=partial appleMusic=unverified)
  string(REPLACE "=" ";" pair "${player_verdict}")
  list(GET pair 0 player)
  list(GET pair 1 expected)
  probe_row("${json}" ${player} index)
  if(index LESS 0)
    probe_fail("the merged report has no ${player} row")
  endif()
  string(JSON verdict GET "${json}" rows ${index} verdict)
  if(NOT verdict STREQUAL expected)
    probe_fail("${player} is ${verdict}, expected ${expected}")
  endif()
endforeach()
foreach(secret "Replay One" "Replay Artist" "Replay Album" "C:\\\\Replay")
  string(FIND "${json}" "${secret}" at)
  if(NOT at EQUAL -1)
    probe_fail("the report stores '${secret}'")
  endif()
endforeach()
file(READ "${markdown}" md)
string(FIND "${md}" "| Spotify (desktop) | Spotify.exe | spotify | pass |" at)
if(at EQUAL -1)
  probe_fail("the Markdown has no passing Spotify row")
endif()

# --show prints the stored matrix without reading any media session.
probe_run(code out --show "${report}")
string(FIND "${out}" "# Now Playing acceptance matrix" heading)
string(FIND "${out}" "| QQ Music | QQMusic.exe | qqMusic | fail |" qq)
if(NOT code EQUAL 0 OR heading EQUAL -1 OR qq EQUAL -1)
  probe_fail("--show exited ${code} or printed no matrix")
endif()
probe_run(code out --show "${WORK}/missing.json")
if(code EQUAL 0)
  probe_fail("--show of a missing report succeeded")
endif()

# A window-title player (NetEase Cloud Music without a media session) through
# the same probe: recorded gaps for its timeline and seek, a passing row.
if(DEFINED WINDOWS_SCENARIO)
  probe_run(code out --replay "${WINDOWS_SCENARIO}" --lyrics --volume --command next --report "${WORK}/windows.json" --markdown "${WORK}/windows.md")
  if(NOT code EQUAL 0)
    probe_fail("the window-title replay exited ${code}: ${out}")
  endif()
  if(NOT out MATCHES "\"origin\":\"playerWindow\"")
    probe_fail("the window-title replay printed no playerWindow snapshot")
  endif()
  file(READ "${WORK}/windows.json" wjson)
  probe_row("${wjson}" neteaseDesktop netease)
  if(netease LESS 0)
    probe_fail("the window-title report has no NetEase row")
  endif()
  string(JSON verdict GET "${wjson}" rows ${netease} verdict)
  string(JSON found GET "${wjson}" rows ${netease} checks session detail)
  string(JSON seek GET "${wjson}" rows ${netease} checks seek verdict)
  if(NOT verdict STREQUAL "pass" OR NOT seek STREQUAL "gap" OR NOT found MATCHES "^found by its main window title")
    probe_fail("the window-title NetEase row is ${verdict} (seek ${seek}, session '${found}')")
  endif()
  foreach(secret "Window One" "Replay Artist" "C:\\\\Replay")
    string(FIND "${wjson}" "${secret}" at)
    if(NOT at EQUAL -1)
      probe_fail("the window-title report stores '${secret}'")
    endif()
  endforeach()
  file(READ "${WORK}/windows.md" wmd)
  string(FIND "${wmd}" "| NetEase Cloud Music (desktop) | cloudmusic.exe | netease | pass |" at)
  if(at EQUAL -1)
    probe_fail("the window-title Markdown has no passing NetEase row")
  endif()
endif()

# A file that is not an acceptance report is never overwritten.
file(WRITE "${WORK}/notes.json" "{\"other\":1}")
probe_run(code out --replay "${SCENARIO}" --report "${WORK}/notes.json")
file(READ "${WORK}/notes.json" kept)
if(code EQUAL 0 OR NOT kept STREQUAL "{\"other\":1}")
  probe_fail("a foreign report file was accepted (exit ${code}) or changed")
endif()
# Usage errors (always next to --replay, so a parser fault could never reach
# the live media session).
probe_run(code out --replay "${SCENARIO}" --command louder)
if(NOT code EQUAL 2)
  probe_fail("an unknown command exited ${code}, expected 2")
endif()
foreach(seconds abc 0 -5 12s nan)
  probe_run(code out --replay "${SCENARIO}" --seconds ${seconds})
  if(NOT code EQUAL 2)
    probe_fail("--seconds ${seconds} exited ${code}, expected 2")
  endif()
endforeach()
probe_run(code out --show "${report}" --replay "${SCENARIO}")
if(NOT code EQUAL 2)
  probe_fail("--show with --replay exited ${code}, expected 2")
endif()

file(REMOVE_RECURSE "${WORK}")
message(STATUS "now_playing_probe_matrix: merged replay report, Markdown, --show and refusal checks passed")
