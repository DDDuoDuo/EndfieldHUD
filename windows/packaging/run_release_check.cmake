# CTest endfieldhud_release_contracts: stages the real release artifacts into
# a fresh folder through the three phases of stage_release.cmake, each in its
# own process as the release workflow runs them (tree, package, finish:
# unsigned), so the hand-over between phases is tested on every build. The
# finish phase installs the real setup into temporary folders under a private
# HKCU test subtree, verifies the installed package and uninstalls it
# (packaging_installer_tests --release). Then this script checks the portable
# zip listing, the size report, SHA256SUMS and the symbols checksum.
cmake_minimum_required(VERSION 3.25)
foreach(required BUILD CONFIG SOURCE OUT PACKER STUB UNINSTALLER CHECKER)
  if(NOT ${required})
    message(FATAL_ERROR "${required} is required")
  endif()
endforeach()
# A build without developer symbols stages a stand-in PDB, so the symbols
# archive and its separate checksum file are always checked.
file(REMOVE_RECURSE "${OUT}-symbols")
if(NOT SYMBOLS OR NOT EXISTS "${SYMBOLS}")
  set(SYMBOLS "${OUT}-symbols/EndfieldHUD.pdb")
  file(WRITE "${SYMBOLS}" "stand-in symbols for endfieldhud_release_contracts\n")
endif()
function(run_phase phase)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DPHASE=${phase}" "-DSOURCE=${SOURCE}" "-DOUT=${OUT}" ${ARGN}
    -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/stage_release.cmake" RESULT_VARIABLE staged OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  message(STATUS "${output}${errors}")
  if(NOT staged EQUAL 0)
    message(FATAL_ERROR "stage_release PHASE=${phase} failed (${staged})")
  endif()
endfunction()
run_phase(tree "-DBUILD=${BUILD}" "-DCONFIG=${CONFIG}" "-DPACKER=${PACKER}" "-DSTUB=${STUB}" "-DUNINSTALLER=${UNINSTALLER}" "-DSYMBOLS=${SYMBOLS}")
run_phase(package)
run_phase(finish "-DCHECKER=${CHECKER}")

file(READ "${SOURCE}/source-authority.json" authority)
string(JSON release GET "${authority}" release)
string(JSON build GET "${authority}" windowsBuild)
string(REGEX REPLACE "^v" "" release "${release}")
set(stem "${OUT}/EndfieldHUD-${release}-build${build}-windows-x64")
file(GLOB staged RELATIVE "${OUT}" "${OUT}/*")
list(SORT staged)
set(expected "")
foreach(suffix IN ITEMS -SHA256SUMS.txt -portable.zip -setup.exe -size-report.json -size-report.md -symbols-SHA256SUMS.txt -symbols.zip)
  list(APPEND expected "EndfieldHUD-${release}-build${build}-windows-x64${suffix}")
endforeach()
list(SORT expected)
if(NOT staged STREQUAL expected)
  message(FATAL_ERROR "The staging folder holds unexpected files:\n${staged}\nexpected:\n${expected}")
endif()

execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${stem}-portable.zip" RESULT_VARIABLE listed OUTPUT_VARIABLE listing)
if(NOT listed EQUAL 0)
  message(FATAL_ERROR "The portable zip cannot be listed")
endif()
string(REPLACE "\n" ";" entries "${listing}")
list(FILTER entries EXCLUDE REGEX "^$")
foreach(required IN ITEMS "EndfieldHUD/EndfieldHUD.exe" "EndfieldHUD/resources/resources.json" "EndfieldHUD/THIRD-PARTY-NOTICES.txt")
  list(FIND entries "${required}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "The portable zip lacks ${required}:\n${listing}")
  endif()
endforeach()
foreach(entry IN LISTS entries)
  if(NOT entry MATCHES "^EndfieldHUD/(EndfieldHUD\\.exe|THIRD-PARTY-NOTICES\\.txt|fonts(/.*)?|resources(/.*)?)?$" OR entry MATCHES "\\.(pdb|ilk|gif|mp4|mov)$" OR entry MATCHES "uninstall\\.exe")
    message(FATAL_ERROR "Unexpected portable zip entry: ${entry}")
  endif()
endforeach()
file(READ "${stem}-size-report.json" report)
string(JSON installed_bytes GET "${report}" installed bytes)
string(JSON artifacts LENGTH "${report}" artifacts)
string(JSON signed GET "${report}" signed)
if(installed_bytes LESS 1000000 OR NOT artifacts EQUAL 3 OR signed)
  message(FATAL_ERROR "The size report is incomplete or claims a signature:\n${report}")
endif()

# SHA256SUMS lists exactly the uploaded files: the setup (the line the Windows
# updater reads) and the portable zip. The symbols zip has its own file.
file(SHA256 "${stem}-setup.exe" setup_sha)
file(SHA256 "${stem}-portable.zip" portable_sha)
get_filename_component(setup_name "${stem}-setup.exe" NAME)
get_filename_component(portable_name "${stem}-portable.zip" NAME)
file(READ "${stem}-SHA256SUMS.txt" sums)
if(NOT sums STREQUAL "${setup_sha}  ${setup_name}\n${portable_sha}  ${portable_name}\n")
  message(FATAL_ERROR "SHA256SUMS must list exactly the setup and the portable zip:\n${sums}")
endif()
file(SHA256 "${stem}-symbols.zip" symbols_sha)
get_filename_component(symbols_name "${stem}-symbols.zip" NAME)
file(READ "${stem}-symbols-SHA256SUMS.txt" symbols_sums)
if(NOT symbols_sums STREQUAL "${symbols_sha}  ${symbols_name}\n")
  message(FATAL_ERROR "The symbols checksum file must list exactly the symbols zip:\n${symbols_sums}")
endif()
file(REMOVE_RECURSE "${OUT}" "${OUT}-symbols")
message(STATUS "Release artifacts staged in three phases, installed and removed (${installed_bytes} installed bytes)")
