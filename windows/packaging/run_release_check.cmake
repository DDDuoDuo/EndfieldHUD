# CTest endfieldhud_release_contracts: stages the real release artifacts into
# a fresh folder, checks the portable zip listing, then installs the real
# setup into temporary folders under a private HKCU test subtree, verifies the
# installed package and uninstalls it (packaging_installer_tests --release).
cmake_minimum_required(VERSION 3.25)
if(NOT CHECKER)
  message(FATAL_ERROR "CHECKER is required")
endif()
file(REMOVE_RECURSE "${OUT}")
set(ALLOW_INCOMPLETE ON)
include("${CMAKE_CURRENT_LIST_DIR}/stage_release.cmake")

execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${EHUD_STAGED_PORTABLE}" RESULT_VARIABLE listed OUTPUT_VARIABLE listing)
if(NOT listed EQUAL 0)
  message(FATAL_ERROR "The portable zip cannot be listed")
endif()
string(REPLACE "\n" ";" entries "${listing}")
list(FILTER entries EXCLUDE REGEX "^$")
list(FIND entries "EndfieldHUD/EndfieldHUD.exe" exe)
list(FIND entries "EndfieldHUD/resources/resources.json" manifest)
if(exe EQUAL -1 OR manifest EQUAL -1)
  message(FATAL_ERROR "The portable zip lacks EndfieldHUD.exe or resources.json:\n${listing}")
endif()
foreach(entry IN LISTS entries)
  if(NOT entry MATCHES "^EndfieldHUD/(EndfieldHUD\\.exe|fonts(/.*)?|resources(/.*)?)?$" OR entry MATCHES "\\.(pdb|ilk|gif|mp4|mov)$" OR entry MATCHES "uninstall\\.exe")
    message(FATAL_ERROR "Unexpected portable zip entry: ${entry}")
  endif()
endforeach()
file(READ "${EHUD_STAGED_REPORT}" report)
string(JSON installed_bytes GET "${report}" installed bytes)
string(JSON artifacts LENGTH "${report}" artifacts)
if(installed_bytes LESS 1000000 OR artifacts LESS 2)
  message(FATAL_ERROR "The size report is incomplete:\n${report}")
endif()

# The release-notes draft names the Windows tag and the staged artifacts.
file(READ "${EHUD_STAGED_NOTES}" notes)
file(SHA256 "${EHUD_STAGED_SETUP}" setup_sha)
get_filename_component(setup_name "${EHUD_STAGED_SETUP}" NAME)
get_filename_component(sums_name "${EHUD_STAGED_SUMS}" NAME)
string(JSON notes_release GET "${report}" release)
string(REGEX REPLACE "^v" "" notes_release "${notes_release}")
# The first-release text: its gap list and the exporter at the Windows tag.
foreach(expected IN ITEMS "windows-v${notes_release}" "${setup_sha}" "${setup_name}" "${sums_name}" "--latest=false"
    "## Differences from the macOS version" "## Moving from a Mac"
    "blob/windows-v${notes_release}/windows/tools/mac_import_exporter.py")
  string(FIND "${notes}" "${expected}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "The release-notes draft lacks '${expected}':\n${notes}")
  endif()
endforeach()
if(notes MATCHES "@EHUD_" OR (NOT EHUD_STAGED_COMPLETE AND NOT notes MATCHES "Do not publish"))
  message(FATAL_ERROR "The release-notes draft is not fully rendered:\n${notes}")
endif()
file(READ "${EHUD_STAGED_SUMS}" sums)
if(NOT sums MATCHES "${setup_sha}  ${setup_name}\n")
  message(FATAL_ERROR "SHA256SUMS lacks the setup line the Windows updater reads:\n${sums}")
endif()

execute_process(COMMAND "${CHECKER}" --release "${EHUD_STAGED_SETUP}" RESULT_VARIABLE checked OUTPUT_VARIABLE output ERROR_VARIABLE errors)
message(STATUS "${output}")
if(NOT checked EQUAL 0)
  message(FATAL_ERROR "The staged setup failed its install check (${checked}):\n${output}\n${errors}")
endif()
file(REMOVE_RECURSE "${OUT}")
message(STATUS "Release artifacts staged, installed and removed (complete: ${EHUD_STAGED_COMPLETE}, ${installed_bytes} installed bytes)")
