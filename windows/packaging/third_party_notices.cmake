# THIRD-PARTY-NOTICES.txt of the EndfieldHUD Windows package, rendered from
# packaging/third-party-notices.json: every third-party component compiled
# into EndfieldHUD.exe, EndfieldHUD-Setup.exe or uninstall.exe, or shipped in
# fonts/ or resources/, with its full licence text. The EndfieldHUD install
# component ships the file next to EndfieldHUD.exe, so it is in the portable
# zip, the setup's payload and the install manifest (the uninstall list).
#
# include():  ehud_write_third_party_notices(<windows/> <output file>)
#   renders the file at configure time (UTF-8, CRLF; rewritten only when it
#   changes) and reconfigures when the list or a licence text changes.
#
# cmake -DSOURCE=<windows/> -DNOTICES=<rendered file>
#       [-DRESOURCE_SPECS=<build>/endfieldhud-resources.txt] -P third_party_notices.cmake
#   (CTest packaging_third_party_notices_contracts) fails when a shipped
#   component's notice is missing:
#   - a windows/third_party folder, a bundled font, a licence or notice file,
#     or a source file whose comments name a licence or an algorithm
#     reference, that no component (or "notShipped" entry) covers;
#   - a component text that is not in the rendered file, or a rendered file
#     that differs from the list (stale build);
#   - a licence or notice file in a folder staged into resources/ whose text
#     is not in the rendered file (e.g. Matter.js inside the OrbiPom folder);
#   - a copy under packaging/licenses that differs from its macOS original;
#   - third-party code fetched by the build (FetchContent, ExternalProject,
#     NuGet package references), which this list cannot see.
if(CMAKE_SCRIPT_MODE_FILE)
  cmake_minimum_required(VERSION 3.25)
endif()

# Text with LF line ends and no trailing blank space.
function(ehud_notices_text path out)
  file(READ "${path}" text)
  string(REPLACE "\r\n" "\n" text "${text}")
  string(REGEX REPLACE "[ \t\n]+$" "" text "${text}")
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

function(ehud_notices_field json out)
  string(JSON value ERROR_VARIABLE missing GET "${json}" ${ARGN})
  if(missing)
    set(value "")
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(ehud_notices_count json out)
  string(JSON value ERROR_VARIABLE missing LENGTH "${json}" ${ARGN})
  if(missing)
    set(value 0)
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

# Renders the notices (LF) into `out`; `inputs` receives every file read.
function(ehud_render_third_party_notices source out inputs)
  set(list_file "${source}/packaging/third-party-notices.json")
  file(READ "${list_file}" json)
  set(read "${list_file}")
  set(rule "==============================================================================")
  set(thin "------------------------------------------------------------------------------")
  set(text "EndfieldHUD for Windows: third-party notices\n============================================\n\n")
  ehud_notices_count("${json}" paragraphs preamble)
  if(paragraphs GREATER 0)
    math(EXPR last "${paragraphs} - 1")
    foreach(index RANGE ${last})
      ehud_notices_field("${json}" paragraph preamble ${index})
      string(APPEND text "${paragraph}\n\n")
    endforeach()
  endif()
  ehud_notices_count("${json}" count components)
  if(count EQUAL 0)
    message(FATAL_ERROR "third-party-notices.json lists no components")
  endif()
  math(EXPR last "${count} - 1")
  string(APPEND text "Components\n----------\n\n")
  foreach(index RANGE ${last})
    math(EXPR number "${index} + 1")
    ehud_notices_field("${json}" name components ${index} name)
    ehud_notices_field("${json}" license components ${index} license)
    string(APPEND text "${number}. ${name} - ${license}\n")
  endforeach()
  foreach(index RANGE ${last})
    math(EXPR number "${index} + 1")
    foreach(key name version url license use)
      ehud_notices_field("${json}" ${key} components ${index} ${key})
    endforeach()
    string(APPEND text "\n\n${rule}\n${number}. ${name}\n${rule}\n\nVersion:  ${version}\n")
    if(url)
      string(APPEND text "Source:   ${url}\n")
    endif()
    string(APPEND text "Licence:  ${license}\nUsed for: ${use}\n")
    ehud_notices_count("${json}" ships components ${index} ships)
    if(ships GREATER 0)
      math(EXPR ships_last "${ships} - 1")
      foreach(ship RANGE ${ships_last})
        ehud_notices_field("${json}" shipped components ${index} ships ${ship})
        if(ship EQUAL 0)
          string(APPEND text "Ships in: ${shipped}\n")
        else()
          string(APPEND text "          ${shipped}\n")
        endif()
      endforeach()
    endif()
    ehud_notices_field("${json}" attribution components ${index} attribution)
    if(attribution)
      string(APPEND text "\n${attribution}\n")
    endif()
    ehud_notices_count("${json}" texts components ${index} texts)
    if(texts GREATER 0)
      math(EXPR texts_last "${texts} - 1")
      foreach(position RANGE ${texts_last})
        ehud_notices_field("${json}" relative components ${index} texts ${position})
        ehud_notices_text("${source}/${relative}" licence)
        list(APPEND read "${source}/${relative}")
        if(position GREATER 0)
          string(APPEND text "\n${thin}\n")
        endif()
        string(APPEND text "\n${licence}\n")
      endforeach()
    endif()
  endforeach()
  set(${out} "${text}" PARENT_SCOPE)
  set(${inputs} "${read}" PARENT_SCOPE)
endfunction()

function(ehud_write_third_party_notices source output)
  ehud_render_third_party_notices("${source}" text inputs)
  set(existing "")
  if(EXISTS "${output}")
    file(READ "${output}" existing) # file(READ) returns CRLF line ends as LF
    string(REPLACE "\r\n" "\n" existing "${existing}")
  endif()
  if(NOT existing STREQUAL text)
    string(REPLACE "\n" "\r\n" text "${text}")
    file(WRITE "${output}" "${text}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${inputs})
endfunction()

# The check runs only as `cmake -P` of this file (never when included).
if(NOT CMAKE_SCRIPT_MODE_FILE)
  return()
endif()
get_filename_component(ehud_notices_script "${CMAKE_SCRIPT_MODE_FILE}" REALPATH)
get_filename_component(ehud_notices_this "${CMAKE_CURRENT_LIST_FILE}" REALPATH)
if(NOT ehud_notices_script STREQUAL ehud_notices_this)
  return()
endif()

# --- Contract check (cmake -P) ----------------------------------------------
foreach(required SOURCE NOTICES)
  if(NOT ${required})
    message(FATAL_ERROR "third_party_notices: ${required} is required")
  endif()
endforeach()
get_filename_component(SOURCE "${SOURCE}" ABSOLUTE)
set(failures "")
function(ehud_notices_fail what)
  set(failures "${failures}\n  - ${what}" PARENT_SCOPE)
endfunction()

if(NOT EXISTS "${NOTICES}")
  message(FATAL_ERROR "third_party_notices: ${NOTICES} was not rendered")
endif()
file(READ "${NOTICES}" rendered)
string(REPLACE "\r\n" "\n" rendered "${rendered}")
ehud_render_third_party_notices("${SOURCE}" expected inputs)
if(NOT rendered STREQUAL expected)
  ehud_notices_fail("${NOTICES} differs from packaging/third-party-notices.json and its licence texts (configure again)")
endif()
ehud_notices_text("${NOTICES}" notices)

file(READ "${SOURCE}/packaging/third-party-notices.json" json)
string(JSON format GET "${json}" format)
string(JSON schema GET "${json}" schema)
if(NOT format STREQUAL "EndfieldHUD.Windows.ThirdPartyNotices" OR NOT schema EQUAL 1)
  ehud_notices_fail("third-party-notices.json has an unknown format")
endif()

# Every component: complete fields, existing files, its notice in the file.
set(covered "")
set(texts "")
ehud_notices_count("${json}" count components)
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
  ehud_notices_field("${json}" name components ${index} name)
  foreach(key name version license use)
    ehud_notices_field("${json}" value components ${index} ${key})
    if(value STREQUAL "")
      ehud_notices_fail("component ${index} (${name}) has no ${key}")
    endif()
  endforeach()
  ehud_notices_count("${json}" ships components ${index} ships)
  if(ships EQUAL 0)
    ehud_notices_fail("${name} does not say where it ships")
  endif()
  ehud_notices_count("${json}" paths components ${index} paths)
  if(paths GREATER 0)
    math(EXPR paths_last "${paths} - 1")
    foreach(position RANGE ${paths_last})
      ehud_notices_field("${json}" relative components ${index} paths ${position})
      if(NOT EXISTS "${SOURCE}/${relative}")
        ehud_notices_fail("${name}: ${relative} does not exist")
      endif()
      list(APPEND covered "${relative}")
    endforeach()
  endif()
  ehud_notices_field("${json}" attribution components ${index} attribution)
  ehud_notices_count("${json}" text_count components ${index} texts)
  if(text_count EQUAL 0 AND attribution STREQUAL "")
    ehud_notices_fail("${name} has neither a licence text nor an attribution")
  endif()
  if(attribution)
    string(FIND "${notices}" "${attribution}" found)
    if(found EQUAL -1)
      ehud_notices_fail("${name}: its attribution is missing from THIRD-PARTY-NOTICES.txt")
    endif()
  endif()
  if(text_count GREATER 0)
    math(EXPR texts_last "${text_count} - 1")
    foreach(position RANGE ${texts_last})
      ehud_notices_field("${json}" relative components ${index} texts ${position})
      if(NOT EXISTS "${SOURCE}/${relative}")
        ehud_notices_fail("${name}: licence text ${relative} does not exist")
        continue()
      endif()
      list(APPEND covered "${relative}")
      list(APPEND texts "${relative}")
      ehud_notices_text("${SOURCE}/${relative}" licence)
      if(licence STREQUAL "")
        ehud_notices_fail("${name}: licence text ${relative} is empty")
      endif()
      string(FIND "${notices}" "${licence}" found)
      if(found EQUAL -1)
        ehud_notices_fail("${name}: the text of ${relative} is missing from THIRD-PARTY-NOTICES.txt")
      endif()
    endforeach()
  endif()
  # A copy of a macOS notice must stay identical to it.
  ehud_notices_field("${json}" original components ${index} macOriginal)
  if(original AND EXISTS "${SOURCE}/${original}" AND text_count GREATER 0)
    ehud_notices_field("${json}" relative components ${index} texts 0)
    ehud_notices_text("${SOURCE}/${original}" mac_text)
    ehud_notices_text("${SOURCE}/${relative}" copy_text)
    if(NOT mac_text STREQUAL copy_text)
      ehud_notices_fail("${name}: ${relative} differs from its macOS original ${original}")
    endif()
  endif()
endforeach()
ehud_notices_count("${json}" not_shipped notShipped)
if(not_shipped GREATER 0)
  math(EXPR last "${not_shipped} - 1")
  foreach(index RANGE ${last})
    ehud_notices_field("${json}" relative notShipped ${index} path)
    ehud_notices_field("${json}" reason notShipped ${index} reason)
    if(NOT EXISTS "${SOURCE}/${relative}" OR reason STREQUAL "")
      ehud_notices_fail("notShipped entry ${relative} does not exist or gives no reason")
    endif()
    list(APPEND covered "${relative}")
  endforeach()
endif()

# True when `relative` (a path below windows/) is a covered path or lies in one.
function(ehud_notices_covered relative out)
  set(result OFF)
  foreach(path IN LISTS covered)
    if(relative STREQUAL path OR relative MATCHES "^${path}/")
      set(result ON)
      break()
    endif()
  endforeach()
  set(${out} ${result} PARENT_SCOPE)
endfunction()

# Vendored folders and bundled fonts.
file(GLOB vendored LIST_DIRECTORIES true RELATIVE "${SOURCE}" "${SOURCE}/third_party/*")
foreach(folder IN LISTS vendored)
  if(IS_DIRECTORY "${SOURCE}/${folder}")
    ehud_notices_covered("${folder}" ok)
    if(NOT ok)
      ehud_notices_fail("${folder} is vendored but no component in third-party-notices.json covers it")
    endif()
  endif()
endforeach()
file(GLOB_RECURSE candidates RELATIVE "${SOURCE}" "${SOURCE}/*")
list(FILTER candidates EXCLUDE REGEX "(^|/)tests?/")
foreach(relative IN LISTS candidates)
  get_filename_component(file_name "${relative}" NAME)
  string(TOUPPER "${file_name}" upper)
  set(kind "")
  if(upper MATCHES "\\.(TTF|OTF|TTC|WOFF2?)$")
    set(kind "bundled font")
  elseif(upper MATCHES "^(LICEN[CS]E|NOTICE|COPYING)" OR upper MATCHES "[-_.](LICEN[CS]E|NOTICE|OFL|COPYING)[-_.A-Z0-9]*\\.(TXT|MD)$")
    set(kind "licence or notice file")
  endif()
  if(kind)
    ehud_notices_covered("${relative}" ok)
    if(NOT ok)
      ehud_notices_fail("${relative} (${kind}) is not covered by third-party-notices.json")
    endif()
  endif()
endforeach()

# Code ported or adapted from other projects: comments naming a licence, a
# copyright, an upstream notice or an algorithm reference.
file(GLOB_RECURSE sources RELATIVE "${SOURCE}" "${SOURCE}/*.c" "${SOURCE}/*.cpp" "${SOURCE}/*.h" "${SOURCE}/*.hpp" "${SOURCE}/*.hlsl"
  "${SOURCE}/*.inc" "${SOURCE}/*.in")
list(FILTER sources EXCLUDE REGEX "(^|/)tests?/|^third_party/")
foreach(relative IN LISTS sources)
  file(STRINGS "${SOURCE}/${relative}" marked LIMIT_COUNT 1
    REGEX "^[ \t]*(//|/\\*|\\*|#|;)(.*[^A-Za-z])?(Algorithm reference|SPDX-License-Identifier|Licensed under|Copyright|\\(MIT|MIT\\)|MIT [Ll]icen[cs]e|BSD|Apache License|GPL|[Uu]pstream (notice|licen[cs]e))")
  if(marked)
    ehud_notices_covered("${relative}" ok)
    if(NOT ok)
      string(STRIP "${marked}" marked)
      ehud_notices_fail("${relative} names third-party code (\"${marked}\") but no component covers it")
    endif()
  endif()
endforeach()

# Fetched dependencies would bypass this list.
file(GLOB_RECURSE build_scripts "${SOURCE}/CMakeLists.txt" "${SOURCE}/cmake/*.cmake")
foreach(script IN LISTS build_scripts)
  file(STRINGS "${script}" fetched REGEX "^[ \t]*(FetchContent_Declare|FetchContent_Populate|ExternalProject_Add)[ \t]*\\(|VS_PACKAGE_REFERENCES")
  if(fetched)
    ehud_notices_fail("${script} fetches a dependency (${fetched}): list it in third-party-notices.json and extend this check")
  endif()
endforeach()

# Licence and notice files inside the folders staged into resources/ (also
# external inputs, such as the OrbiPom folder with Matter.js's licence).
set(staged_licences 0)
if(RESOURCE_SPECS AND EXISTS "${RESOURCE_SPECS}")
  file(STRINGS "${RESOURCE_SPECS}" specs)
  foreach(spec IN LISTS specs)
    string(REPLACE "|" ";" fields "${spec}")
    list(LENGTH fields field_count)
    if(NOT field_count EQUAL 4)
      continue()
    endif()
    list(GET fields 1 kind)
    list(GET fields 2 staged_source)
    list(GET fields 3 destination)
    set(files "")
    if(kind STREQUAL "directory" AND IS_DIRECTORY "${staged_source}")
      file(GLOB_RECURSE files "${staged_source}/*")
    elseif(kind STREQUAL "file" AND EXISTS "${staged_source}")
      set(files "${staged_source}")
    endif()
    foreach(file IN LISTS files)
      get_filename_component(file_name "${file}" NAME)
      string(TOUPPER "${file_name}" upper)
      if(upper MATCHES "^(LICEN[CS]E|NOTICE|COPYING)" OR upper MATCHES "[-_.](LICEN[CS]E|NOTICE|OFL|COPYING)[-_.A-Z0-9]*\\.(TXT|MD)$")
        math(EXPR staged_licences "${staged_licences} + 1")
        ehud_notices_text("${file}" licence)
        string(FIND "${notices}" "${licence}" found)
        if(found EQUAL -1)
          ehud_notices_fail("resources/${destination}: ${file_name} ships, but its text is not in THIRD-PARTY-NOTICES.txt")
        endif()
      elseif(upper MATCHES "\\.(TTF|OTF|TTC|WOFF2?)$")
        ehud_notices_fail("resources/${destination}: the font ${file_name} ships without a component in third-party-notices.json")
      endif()
    endforeach()
  endforeach()
endif()

if(failures)
  message(FATAL_ERROR "Third-party notices are incomplete:${failures}")
endif()
list(LENGTH texts text_total)
message(STATUS "Third-party notices: ${count} components, ${text_total} licence texts in ${NOTICES}; ${staged_licences} staged licence files checked")
