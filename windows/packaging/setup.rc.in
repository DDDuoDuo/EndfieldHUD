// Generated by cmake/modules/packaging.cmake (EndfieldHUD-Setup.exe and
// uninstall.exe). Version from windows/source-authority.json; flagged
// prerelease/private until DDDuoDuo chooses a Windows release.
#include <winres.h>

1 ICON "@EHUD_APP_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @EHUD_APP_VERSION_COMMAS@
 PRODUCTVERSION @EHUD_APP_VERSION_COMMAS@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE | VS_FF_PRIVATEBUILD
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "DDDuoDuo"
      VALUE "FileDescription", "@EHUD_SETUP_DESCRIPTION@"
      VALUE "FileVersion", "@EHUD_APP_VERSION_DOTS@"
      VALUE "InternalName", "@EHUD_SETUP_NAME@"
      VALUE "LegalCopyright", "Copyright (C) 2026 DDDuoDuo. MIT License."
      VALUE "OriginalFilename", "@EHUD_SETUP_FILE@"
      VALUE "PrivateBuild", "Windows development port of macOS @EHUD_APP_RELEASE@ build @EHUD_APP_BUILD@ (@EHUD_APP_COMMIT@)"
      VALUE "ProductName", "EndfieldHUD"
      VALUE "ProductVersion", "@EHUD_APP_RELEASE@ (@EHUD_APP_BUILD@) Windows development"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
